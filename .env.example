# ---- VLM 配置（可选。不配置时策略链自动跳过 VLM 层级，read_screen 不可用）----
# 预设：openai | qwen | ollama | kimi-code | custom
VISION_PROVIDER=ollama

# openai:    https://api.openai.com/v1        模型示例: gpt-4o
# qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1   模型示例: qwen-vl-max
# ollama:    http://localhost:11434/v1        模型示例: qwen2.5vl:7b / llama3.2-vision
# kimi-code: https://api.kimi.com/coding/v1   模型: kimi-for-coding
#            （复用 Kimi CLI 的 OAuth 登录态，token 自动刷新，无需填 key）
VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=
VISION_MODEL=qwen2.5vl:7b

# ---- 截图设置 ----
# 截图最长边缩放上限（降低 MCP 传输与 VLM 成本），0 = 不缩放
SCREENSHOT_MAX_SIZE=1280
# JPEG 质量 1-95
SCREENSHOT_JPEG_QUALITY=80
